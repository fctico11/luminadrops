# Postgres connection string (Vercel Postgres / Neon / Supabase all work)
DATABASE_URL="postgresql://user:password@localhost:5432/luminadrops?schema=public"

# Random 32+ char secret used to sign admin session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Shared password for the /admin portal (site content editor + product dashboard).
ADMIN_PASSWORD="test123"

# GitHub token used to commit inline content edits made from /admin.
# Create at https://github.com/settings/personal-access-tokens/new
# Fine-grained token, scoped to this repo only, with "Contents: Read and write".
GITHUB_TOKEN="github_pat_..."
GITHUB_OWNER="your-github-username-or-org"
GITHUB_REPO="luminadrops"
GITHUB_BRANCH="main"

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Publishable key, safe to expose client-side — powers the embedded on-site
# checkout at /checkout (Stripe Elements, not the hosted checkout.stripe.com page).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Vercel Blob (Vercel dashboard -> Storage -> Blob -> create store)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Resend (https://resend.com/api-keys) — waitlist signups are added as contacts
# to this segment. Create a segment once at https://resend.com/audiences
# (or via the API) and paste its id here.
RESEND_API_KEY="re_..."
RESEND_SEGMENT_ID="..."

# Public base URL, used to build Stripe success/cancel redirect links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
